<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leena EMS - Management Panel</title>
    <style>
        :root {
            --primary-bg: #f8f9fa;
            --sidebar-bg: #2c3e50;
            --sidebar-text: #ecf0f1;
            --sidebar-hover: #34495e;
            --header-border: #dee2e6;
            --card-bg: #ffffff;
            --card-shadow: 0 4px 8px rgba(0,0,0,0.05);
            --text-primary: #212529;
            --text-secondary: #6c757d;
            --accent-color: #3498db;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--primary-bg);
            display: flex;
            height: 100vh;
            overflow: hidden;
        }
        .sidebar {
            width: 240px;
            background-color: var(--sidebar-bg);
            color: var(--sidebar-text);
            padding: 20px 0;
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
        }
        .sidebar-header {
            padding: 0 20px 20px 20px;
            font-size: 1.5em;
            font-weight: bold;
            border-bottom: 1px solid var(--sidebar-hover);
        }
        .sidebar-menu { list-style-type: none; margin-top: 20px; }
        .sidebar-menu a {
            display: block;
            color: var(--sidebar-text);
            text-decoration: none;
            padding: 15px 20px;
            transition: background-color 0.2s;
            cursor: pointer;
        }
        .sidebar-menu a:hover, .sidebar-menu a.active { background-color: var(--sidebar-hover); }
        .main-wrapper { flex-grow: 1; display: flex; flex-direction: column; overflow: hidden; }
        .main-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            background-color: var(--card-bg);
            border-bottom: 1px solid var(--header-border);
            flex-shrink: 0;
        }
        .main-header h1 { font-size: 1.8em; color: var(--text-primary); }
        .header-buttons {
            display: flex;
            gap: 10px;
        }
        .btn {
            padding: 10px 15px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 500;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        .btn-back {
            background-color: #6c757d;
            color: white;
        }
        .btn-back:hover {
            background-color: #5a6268;
        }
        #logout-btn {
            background-color: #e74c3c; 
            color: white;
        }
        #logout-btn:hover {
            background-color: #c0392b;
        }
        #content-area {
            flex-grow: 1;
            overflow: hidden;
            position: relative;
        }
        .content-frame {
            width: 100%;
            height: 100%;
            border: none;
        }
        .loader { 
            text-align: center; 
            padding: 40px; 
            font-size: 1.2em;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }
        .dashboard-content {
            padding: 20px;
            overflow-y: auto;
            height: 100%;
        }
        .dashboard-grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); 
            gap: 20px;
            margin-top: 20px;
        }
        .stat-card {
            background-color: var(--card-bg); 
            padding: 20px;
            border-radius: 8px; 
            box-shadow: var(--card-shadow);
        }
        .stat-card .value { 
            font-size: 2.5em; 
            font-weight: bold; 
            color: var(--accent-color); 
        }
        .stat-card .label { 
            font-size: 1em; 
            color: var(--text-secondary); 
            margin-top: 5px;
        }
        .action-buttons {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }
        .btn-primary {
            background-color: var(--accent-color);
            color: white;
        }
        .btn-primary:hover {
            background-color: #2980b9;
        }
        .table-container { 
            overflow-x: auto;
            background: white;
            border-radius: 8px;
            padding: 20px;
            margin-top: 20px;
        }
        table { 
            width: 100%; 
            border-collapse: collapse; 
        }
        th, td { 
            padding: 12px 15px; 
            text-align: left; 
            border-bottom: 1px solid var(--header-border); 
        }
        th { 
            background-color: var(--primary-bg);
            font-weight: 600;
        }
        tr:hover {
            background-color: #f8f9fa;
        }
    </style>
</head>
<body>

    <nav class="sidebar">
        <div class="sidebar-header">Leena EMS</div>
        <ul class="sidebar-menu" id="sidebar-menu">
            <li><a onclick="loadDashboard()" class="active">📊 Dashboard</a></li>
            <li><a onclick="loadVisitors()">👥 Visitors</a></li>
            <li><a onclick="loadForms()">📝 Forms</a></li>
            <li><a onclick="loadCheckins()">✅ Check-ins</a></li>
            <li><a onclick="loadEmailTemplates()">📧 Email Templates</a></li>
            <li><a onclick="loadReports()">📈 Reports</a></li>
            <li><a onclick="loadImport()">📥 Import</a></li>
        </ul>
    </nav>

    <div class="main-wrapper">
        <header class="main-header">
            <h1 id="expo-title">Loading...</h1>
            <div class="header-buttons">
                <button class="btn btn-back" onclick="goToDashboard()">
                    ← Back to All Expos
                </button>
                <button id="logout-btn" class="btn" onclick="logout()">
                    Logout
                </button>
            </div>
        </header>
        <main id="content-area">
            <div class="loader" id="mainLoader">Loading...</div>
        </main>
    </div>

    <script>
        const API_BASE_URL = 'http://localhost:3000/api';
        let currentExpoId = null;
        let currentExpoName = null;

        // --- INITIALIZATION ---
        document.addEventListener('DOMContentLoaded', async () => {
            const token = localStorage.getItem('token');
            currentExpoId = localStorage.getItem('selectedExpoId');

            if (!token) {
                window.location.href = 'login.html';
                return;
            }
            if (!currentExpoId) {
                alert('No expo selected. Redirecting to dashboard...');
                window.location.href = 'dashboard.html';
                return;
            }

            await fetchExpoDetails(currentExpoId);
            loadDashboard();
        });

        // --- HELPER FUNCTIONS ---
        function getAuthHeaders() {
            return {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${localStorage.getItem('token')}`
            };
        }

        function setActiveMenu(menuText) {
            document.querySelectorAll('#sidebar-menu a').forEach(a => {
                a.classList.remove('active');
                if (a.textContent.includes(menuText)) {
                    a.classList.add('active');
                }
            });
        }

        function goToDashboard() {
            window.location.href = 'dashboard.html';
        }

        function logout() {
            localStorage.clear();
            window.location.href = 'login.html';
        }

        async function fetchExpoDetails(expoId) {
            try {
                const response = await fetch(`${API_BASE_URL}/expos/${expoId}`, { headers: getAuthHeaders() });
                if (!response.ok) throw new Error('Could not fetch expo details.');
                const expo = await response.json();
                currentExpoName = expo.name;
                document.getElementById('expo-title').textContent = expo.name;
            } catch (error) {
                console.error(error);
                document.getElementById('expo-title').textContent = 'Expo Not Found';
            }
        }

        function showLoader() {
            document.getElementById('content-area').innerHTML = '<div class="loader">Loading...</div>';
        }

        // --- PAGE LOADERS ---

        async function loadDashboard() {
            setActiveMenu('Dashboard');
            showLoader();

            try {
                const response = await fetch(`${API_BASE_URL}/reports/summary?expo_id=${currentExpoId}`, { headers: getAuthHeaders() });
                if(!response.ok) throw new Error('Could not fetch report data.');
                const report = await response.json();

                const metrics = report.visitor_metrics || {};
                const checkins = report.checkin_metrics || {};

                document.getElementById('content-area').innerHTML = `
                    <div class="dashboard-content">
                        <h2>Dashboard Overview</h2>
                        <div class="action-buttons">
                            <button class="btn btn-primary" onclick="loadFormBuilder()">
                                ➕ Create Form
                            </button>
                            <button class="btn btn-primary" onclick="loadImport()">
                                📥 Import Visitors
                            </button>
                        </div>
                        <div class="dashboard-grid">
                            <div class="stat-card">
                                <div class="value">${metrics.total_visitors || 0}</div>
                                <div class="label">Total Visitors</div>
                            </div>
                            <div class="stat-card">
                                <div class="value">${checkins.total_checkins || 0}</div>
                                <div class="label">Total Check-ins</div>
                            </div>
                            <div class="stat-card">
                                <div class="value">${checkins.checkins_today || 0}</div>
                                <div class="label">Check-ins Today</div>
                            </div>
                            <div class="stat-card">
                                <div class="value">${metrics.unique_countries || 0}</div>
                                <div class="label">Unique Countries</div>
                            </div>
                        </div>
                    </div>
                `;
            } catch (error) {
                console.error('Error loading dashboard:', error);
                document.getElementById('content-area').innerHTML = `
                    <div class="dashboard-content">
                        <h2>Dashboard Overview</h2>
                        <p>Could not load the dashboard. Please try again.</p>
                        <button class="btn btn-primary" onclick="loadDashboard()">Retry</button>
                    </div>
                `;
            }
        }

        async function loadVisitors() {
            setActiveMenu('Visitors');
            showLoader();

            try {
                const response = await fetch(`${API_BASE_URL}/visitors?expo_id=${currentExpoId}`, { headers: getAuthHeaders() });
                if (!response.ok) throw new Error('Could not fetch visitor data.');

                const data = await response.json();
                const visitors = data.visitors || [];

                let content = `
                    <div class="dashboard-content">
                        <h2>Visitors (${visitors.length})</h2>
                        <div class="action-buttons">
                            <button class="btn btn-primary" onclick="loadFormBuilder()">
                                ➕ Create Registration Form
                            </button>
                            <button class="btn btn-primary" onclick="loadImport()">
                                📥 Import Visitors
                            </button>
                        </div>
                `;

                if (visitors.length === 0) {
                    content += `<p>No registered visitors found for this expo yet.</p>`;
                } else {
                    content += `
                        <div class="table-container">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Company</th>
                                        <th>Country</th>
                                        <th>Registration Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                    `;

                    visitors.forEach(v => {
                        const fields = v.custom_fields || {};
                        content += `
                            <tr>
                                <td>${v.name || fields.name || fields.full_name || 'N/A'}</td>
                                <td>${v.email || fields.email || 'N/A'}</td>
                                <td>${v.company || fields.company || 'N/A'}</td>
                                <td>${fields.country || 'N/A'}</td>
                                <td>${new Date(v.created_at).toLocaleDateString()}</td>
                            </tr>
                        `;
                    });

                    content += `
                                </tbody>
                            </table>
                        </div>
                    `;
                }

                content += `</div>`;
                document.getElementById('content-area').innerHTML = content;

            } catch (error) {
                console.error('Error loading visitors:', error);
                document.getElementById('content-area').innerHTML = `
                    <div class="dashboard-content">
                        <h2>Visitors</h2>
                        <p>Error: ${error.message}</p>
                        <button class="btn btn-primary" onclick="loadVisitors()">Retry</button>
                    </div>
                `;
            }
        }

        function loadForms() {
            setActiveMenu('Forms');
            document.getElementById('content-area').innerHTML = `
                <iframe src="form-list.html" class="content-frame"></iframe>
            `;
        }

        function loadFormBuilder() {
            window.location.href = 'form-builder.html';
        }

        function loadCheckins() {
            setActiveMenu('Check-ins');
            document.getElementById('content-area').innerHTML = `
                <iframe src="checkins.html" class="content-frame"></iframe>
            `;
        }

        function loadEmailTemplates() {
            setActiveMenu('Email');
            document.getElementById('content-area').innerHTML = `
                <iframe src="email-templates.html" class="content-frame"></iframe>
            `;
        }

        function loadReports() {
            setActiveMenu('Reports');
            document.getElementById('content-area').innerHTML = `
                <iframe src="reports.html" class="content-frame"></iframe>
            `;
        }

        function loadImport() {
            setActiveMenu('Import');
            document.getElementById('content-area').innerHTML = `
                <iframe src="import.html" class="content-frame"></iframe>
            `;
        }
    </script>
</body>
</html>
